# Backend only: never prefix secrets with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Paste your Tiger Data PostgreSQL connection URL, including sslmode=require.
DATABASE_URL=
DATA_CACHE_DIR=data/cache
SIM_RUNS=20
GEMINI_ENABLED=true
MODEL_VERSION=lane-c-b11-v2
JOB_TIMEOUT_MS=1200000
# Browser origins allowed to call the hosted API (JSON array).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
