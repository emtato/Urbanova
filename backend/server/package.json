{
  "name": "futureproof-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "papiers:check": "npm run build && node dist/backend/server/src/scripts/papiers-check.js",
    "investigate": "npm run build && node dist/backend/server/src/scripts/investigate.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/server/src/index.js",
    "test": "npm run build && node --test --test-isolation=none dist/backend/server/test/*.test.js",
    "db:init": "npm run build && node dist/backend/server/src/storage/migrate.js",
    "smoke:db": "npm run build && node dist/backend/server/src/scripts/smoke.js",
    "smoke:b11": "npm run build && node dist/backend/server/src/scripts/b11-smoke.js",
    "test:parser:live": "npm run build && node dist/backend/server/src/scripts/parser-regression.js",
    "seed:data": "npm run build && node dist/backend/server/src/scripts/seed-data.js",
    "pipeline": "npm run build && node dist/backend/server/src/pipeline.js",
    "check:demo": "npm run build && node dist/backend/server/src/scripts/check-demo.js"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "papiers": "0.1.5",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.2"
  }
}
