# Backend only: never prefix secrets with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Paste the Tiger Data PostgreSQL URL here, including sslmode=require.
DATABASE_URL=
# Development credentials only; database is bound to localhost.
DATABASE_URL_LOCAL=postgresql://futureproof:futureproof@localhost:5432/futureproof
DATA_CACHE_DIR=data/cache
SIM_RUNS=100
# true selects local PostGIS; false selects DATABASE_URL when supplied.
OFFLINE=true
