# Local config is read from the repository-root .env; Railway uses service variables.
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=8010
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MODEL_VERSION=lane-c-b11-v1
# Optional path relative to repo root, populated with reviewed/user-selected costs.
# PACKAGE_POLICY_PATH=server/config/package-policy.json

# Optional Python override; otherwise the root .venv or python3 is used.
# PYTHON_EXECUTABLE=/opt/b11/bin/python
# JOB_TIMEOUT_MS=600000
