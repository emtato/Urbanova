# Public browser configuration only; never put Gemini or database credentials here.
# Local development can leave this unset to use Vite's /api proxy on port 8010.
# Production: set this before building the frontend.
VITE_API_BASE_URL=https://urbanova-production-ec5f.up.railway.app/api
VITE_USE_FIXTURE=false
# Public Mapbox token for the existing 3D map.
VITE_MAPBOX_TOKEN=
